# Variables de entorno del backend (leídas por docker-compose.yml)
# Copiar este archivo a .env en la raíz y ajustar para el entorno deseado.

# Base de datos local (servicio postgres del compose)
DB_URL=jdbc:postgresql://postgres:5432/nexus
DB_USERNAME=nexus
DB_PASSWORD=nexus_local_password

# JWT — cambiar por un valor seguro (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS — URL del frontend en producción
CORS_ORIGIN=http://localhost
APP_ENV=production
SERVER_PORT=3000
