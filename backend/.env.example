# ─── Base de datos (local, vía docker-compose) ───
DB_URL=jdbc:postgresql://localhost:5432/nexus
DB_USERNAME=nexus
DB_PASSWORD=nexus_local_password

# ─── JWT ───
# Mínimo 32 caracteres
JWT_SECRET=tu-jwt-secret-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── CORS ───
# Lista separada por comas; localhost:5173 siempre se permite
CORS_ORIGIN=http://localhost:5173
# Opcional: regex para orígenes extra (ej. previews desplegadas)
# CORS_ORIGIN_PATTERN=https://.*\\.tudominio\\.com

# ─── Servidor ───
SERVER_PORT=3000
APP_ENV=development
