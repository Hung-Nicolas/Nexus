{
  "name": "nexus",
  "private": true,
  "version": "1.1.0",
  "description": "Base de datos escolar maestra - Nexus. Frontend Vite + backend Express con Supabase solo como PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" ",
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch backend/src --ignore dist --ignore node_modules backend/src/index.js",
    "build": "vite build",
    "start": "node backend/src/index.js",
    "preview": "vite preview",
    "db:types": "supabase gen types typescript --project-id tu-project-id --schema public > src/lib/database.types.ts"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.16",
    "supabase": "^2.98.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3"
  }
}
