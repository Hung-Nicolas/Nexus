# Variables de entorno del frontend (Vite)
# Copiar este archivo a .env y ajustar para el entorno deseado.

# Para el deploy en el server de la escuela con Docker + Nginx,
# usar una URL relativa para que el navegador haga las peticiones
# al mismo dominio y Nginx las redirija al backend.
VITE_API_URL=/api/v1

# Si se accede directamente al backend sin proxy (solo desarrollo):
# VITE_API_URL=http://localhost:3000/api/v1
